#!/bin/sh
# Marks docs/wiki/.pending-ingest with files touched by this commit, so the
# wiki-ingest skill knows what changed since the last ingest without re-scanning
# the whole repo. Never blocks or slows a commit: every branch below exits 0.
#
# Install (one-time per clone):
#   cp scripts/hooks/post-commit .git/hooks/post-commit && chmod +x .git/hooks/post-commit
#
# The watched set is deliberately wider than docs/: in this repo the wiki
# documents shipped behaviour, so a change under src/ or supabase/ is often the
# thing worth writing up. The skill filters this list down — see step 2 of
# .claude/skills/wiki-ingest/SKILL.md — so over-listing here is cheap and
# under-listing loses the change entirely.

MARKER="docs/wiki/.pending-ingest"

mkdir -p docs/wiki 2>/dev/null || exit 0

git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null \
  | grep -E '^(docs/sources/|src/|supabase/|scripts/|CLAUDE\.md|README\.md|astro\.config\.mjs)' \
  >> "$MARKER" 2>/dev/null

exit 0
