{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/require-wiki-ingest.cjs\"",
            "timeout": 15,
            "statusMessage": "Checking the wiki was ingested"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/helpers/require-wiki-ingest.cjs\"",
            "timeout": 15,
            "statusMessage": "Checking the wiki was ingested"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONUTF8=1 python scripts/agents/decisions.py digest --hook 2>/dev/null || true",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "PYTHONUTF8=1 python scripts/agents/agent_status.py --hook 2>/dev/null || true",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONUTF8=1 python scripts/agents/decisions.py scan --hook 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
