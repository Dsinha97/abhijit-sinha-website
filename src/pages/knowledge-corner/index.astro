---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ComplianceCallout from '../../components/ComplianceCallout.astro';
import ReadingCard from '../../components/knowledge/ReadingCard.astro';
import VideoCard from '../../components/knowledge/VideoCard.astro';
import { getKnowledge, toReadingItems } from '../../lib/knowledge';
import { url } from '../../lib/url';

// Fetched at build time and rendered into static HTML, so the page works with
// JavaScript disabled and is fully visible to search engines. getKnowledge()
// never throws and falls back to the committed snapshot.
const content = await getKnowledge();
const reading = toReadingItems(content);
const videos = content.videos;

// The landing page previews each section; the listing pages hold everything.
// Three, because that is one full grid row at every breakpoint - a preview
// that ends mid-row reads as a loading failure rather than a deliberate cut.
const PREVIEW = 3;

// A plain grid, deliberately not a horizontally scrolling carousel. The
// carousel was the last remaining horizontally scrollable region on this page
// and a phone reporting a layout viewport of 411 against a window of 876 kept
// panning the whole document sideways; the "View all" links already lead to
// the full listings, so the swipe was never the only way to reach anything.
const GRID = 'grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3';
---

<BaseLayout
  title="Knowledge Corner | Abhijit Sinha (ARN-367596)"
  description="Educational articles, videos and curated reading on mutual fund investing, goal planning and portfolio discipline, from AMFI-registered distributor Abhijit Sinha."
>
  <section class="mx-auto max-w-6xl px-4 pt-10 pb-8 sm:px-6 sm:pt-14">
    <p class="text-xs font-semibold uppercase tracking-widest text-accent">Learn</p>
    <h1 class="mt-2 text-3xl font-bold text-slate-900 sm:text-4xl">Knowledge Corner</h1>
    <p class="mt-4 max-w-3xl text-slate-600">
      Plain-language explanations of how mutual funds, systematic investing and goal planning
      actually work. Everything here is educational material published for general readers.
    </p>

    <div class="mt-8 max-w-3xl">
      <ComplianceCallout label="Educational Content Only">
        Articles, videos and linked material on this page are for general education. They are not
        investment advice, not a recommendation of any scheme, and take no account of your personal
        circumstances. Material from other publishers is provided for reference and is not an
        endorsement. Mutual fund investments are subject to market risks &mdash; read all scheme
        related documents carefully.
      </ComplianceCallout>
    </div>
  </section>

  <!-- Reading: own articles and curated third-party links together -->
  <section id="articles" class="scroll-mt-28 border-y border-slate-200 bg-surface py-12 sm:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mb-6 flex flex-wrap items-baseline justify-between gap-3">
        <h2 class="text-2xl font-bold text-slate-900">Articles &amp; Reading</h2>
        {
          reading.length > 0 && (
            <a
              href={url('knowledge-corner/articles')}
              data-track="nav"
              data-track-label="View all articles"
              class="inline-flex min-h-[44px] items-center text-sm font-medium text-accent hover:underline"
            >
              View all articles ({reading.length}) &rarr;
            </a>
          )
        }
      </div>

      {
        reading.length > 0 ? (
          <ul class={GRID} aria-label="Articles and reading">
            {reading.slice(0, PREVIEW).map((item) => (
              <li>
                <ReadingCard
                  kind={item.kind}
                  id={item.id}
                  title={item.title}
                  href={item.href}
                  description={item.description}
                  sourceName={item.sourceName}
                  publishedAt={item.publishedAt}
                  tags={item.tags}
                />
              </li>
            ))}
          </ul>
        ) : (
          <p class="rounded-xl border border-dashed border-slate-300 bg-white p-6 text-sm text-slate-600">
            Articles are being written and will appear here shortly. In the meantime, the{' '}
            <a href={url('solutions')} class="text-accent underline underline-offset-2">
              Solutions
            </a>{' '}
            page explains the approach in detail.
          </p>
        )
      }
    </div>
  </section>

  <!-- Videos -->
  <section id="videos" class="scroll-mt-28 py-12 sm:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mb-6 flex flex-wrap items-baseline justify-between gap-3">
        <h2 class="text-2xl font-bold text-slate-900">Videos</h2>
        {
          videos.length > 0 && (
            <a
              href={url('knowledge-corner/videos')}
              data-track="nav"
              data-track-label="View all videos"
              class="inline-flex min-h-[44px] items-center text-sm font-medium text-accent hover:underline"
            >
              View all videos ({videos.length}) &rarr;
            </a>
          )
        }
      </div>

      {
        videos.length > 0 ? (
          <ul class={GRID} aria-label="Videos">
            {videos.slice(0, PREVIEW).map((v) => (
              <li>
                <VideoCard
                  id={v.id}
                  title={v.title}
                  description={v.description}
                  videoUrl={v.video_url}
                />
              </li>
            ))}
          </ul>
        ) : (
          <p class="rounded-xl border border-dashed border-slate-300 bg-white p-6 text-sm text-slate-600">
            No videos have been published yet.
          </p>
        )
      }
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-12 text-center sm:px-6 sm:py-16">
    <h2 class="text-2xl font-bold text-slate-900">Have a question about any of this?</h2>
    <p class="mt-3 text-slate-600">
      General reading only goes so far. A conversation can cover what actually applies to your
      goals and timeline.
    </p>
    <a
      href={url('schedule')}
      data-track="cta"
      data-track-label="Knowledge Corner CTA"
      class="mt-6 inline-flex min-h-[44px] items-center justify-center rounded-lg bg-slate-900 px-6 py-3 text-sm font-medium text-white transition hover:bg-slate-800"
    >
      Schedule a Meeting
    </a>
  </section>
</BaseLayout>

<script>
  import '../../scripts/knowledge';
</script>
