---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionCard from '../components/SectionCard.astro';
import ComplianceCallout from '../components/ComplianceCallout.astro';
import ContactForm from '../components/ContactForm.astro';
import { url } from '../lib/url';
import { distributor } from '../data/site';

const schemeCards = [
  { title: 'Equity Schemes', desc: 'Long-term capital growth across large, mid, and small-cap opportunities.' },
  { title: 'Hybrid Schemes', desc: 'Balanced growth with lower volatility via equity-debt combinations.' },
  { title: 'Debt Schemes', desc: 'Steady income and capital preservation with minimal equity exposure.' },
  { title: 'Liquid & Overnight Schemes', desc: 'High-liquidity parking for emergency funds and short-term needs.' },
];
---

<BaseLayout
  title="Abhijit Sinha | AMFI-Registered Mutual Fund Distributor"
  description="Goal-based mutual fund distribution and disciplined portfolio allocation with Abhijit Sinha, AMFI-registered Mutual Fund Distributor (ARN-367596)."
>
  <!-- Hero: banner.png / banner-mobile.jpeg are finished graphics (logo, headline,
       tagline, and all four pillars are already drawn into the artwork) — shown
       whole and undistorted, with no text overlay competing with it. The header
       header is in normal flow and opaque (see BaseLayout), so the logo drawn
       into the top of the artwork starts clear of the nav rather than being
       covered by it.

       The banner is 2:1, so at typical desktop widths it renders far taller
       than the viewport — the CTA band below is `sticky bottom-0` as the
       section's last child, which pins it to the bottom of the window while
       the image scrolls past above it, and lets it settle into normal flow
       the instant the section (image + band) ends. No hardcoded height/margin
       math: the browser works out exactly when to release it. -->
  <section class="relative">
    <picture>
      <source media="(max-width: 767px)" srcset={url('images/banner-mobile.jpeg')} />
      <img
        src={url('images/banner.png')}
        alt="Abhijit Sinha, Mutual Fund Distributor, ARN-367596. Smart Investments, Stronger Future — SIP Today, Secure Tomorrow. Goal Based Investing. Risk Managed Portfolios. Disciplined Wealth Creation. Long Term Financial Growth."
        loading="eager"
        fetchpriority="high"
        class="w-full max-w-[1600px] mx-auto block aspect-[759/1600] min-[768px]:aspect-[2/1] object-contain"
      />
    </picture>

    <div class="sticky bottom-0 z-30 bg-white/90 backdrop-blur border-t border-slate-200 shadow-lg">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 py-4 sm:py-6 text-center">
        <h1 class="text-lg sm:text-2xl font-extrabold text-slate-900 leading-tight mb-1.5">
          Plan Your Investment Journey with Clarity and Discipline.
        </h1>
        <p class="text-sm text-slate-600 mb-3">
          Goal-based mutual fund distribution, structured around your timeline and risk profile.
        </p>
        <div class="flex flex-wrap justify-center gap-2.5">
          <a href={url('schedule')} class="min-h-[44px] inline-flex items-center justify-center px-4 py-2 rounded-lg bg-slate-900 text-white font-semibold text-sm hover:bg-slate-800 transition">
            Schedule a 15-Minute Intro Call
          </a>
          <a href={url('solutions')} class="min-h-[44px] inline-flex items-center justify-center px-4 py-2 rounded-lg border border-slate-300 text-slate-700 font-semibold text-sm hover:bg-slate-100 transition">
            Explore Investment Solutions
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Philosophy -->
  <section class="mx-auto max-w-5xl px-4 sm:px-6 py-14 sm:py-20 grid grid-cols-1 sm:grid-cols-2 gap-8 items-center">
    <img src={url('images/Buffet-quote.jpeg')} alt="Investment philosophy quote" class="rounded-xl border border-slate-200 w-full h-auto" />
    <blockquote class="text-lg text-slate-700 leading-relaxed">
      "Discipline and systematic savings form the bedrock of long-term wealth compounding. We focus on structured asset allocation and investor temperament rather than chasing short-term market noise."
    </blockquote>
  </section>

  <!-- About -->
  <section id="about" class="bg-surface border-y border-slate-200 py-14 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 grid grid-cols-1 lg:grid-cols-12 gap-10">
      <div class="lg:col-span-4 flex flex-col items-center lg:items-start text-center lg:text-left">
        <img src={url('images/profile-pic.jpg')} alt={`${distributor.name} — Mutual Fund Distributor`} class="w-48 h-48 rounded-full object-cover object-top border-4 border-white shadow-sm mb-4" />
        <h2 class="text-xl font-bold text-slate-900">{distributor.name}</h2>
        <div class="mt-3 rounded-xl border border-slate-200 bg-white p-4 text-sm text-slate-600 space-y-1">
          <p>Commerce Graduate, MBA in Finance</p>
          <p>35 Years Asset Management Experience</p>
          <p>Former Head of Sales Management at a leading Indian AMC</p>
          <p>AMFI {distributor.arn}</p>
        </div>
        <div class="mt-4 flex flex-col items-center lg:items-start gap-2">
          <a href={url('schedule')} class="inline-flex min-h-[44px] items-center justify-center px-5 py-2.5 rounded-lg bg-slate-900 text-white text-sm font-semibold hover:bg-slate-800 transition">
            Schedule a Conversation
          </a>
          <a
            href={distributor.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${distributor.name} on LinkedIn (opens in a new tab)`}
            class="inline-flex min-h-[44px] items-center justify-center gap-2 px-5 py-2.5 rounded-lg border border-slate-300 text-slate-700 text-sm font-semibold hover:bg-slate-100 transition"
          >
            <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.446-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
            </svg>
            Connect on LinkedIn
          </a>
        </div>
      </div>

      <div class="lg:col-span-8 space-y-4 text-sm sm:text-base text-slate-700 leading-relaxed">
        <p>
          I am {distributor.name}, a commerce graduate and MBA in Finance, with 35 years of professional experience in the Asset Management industry. Over the course of my career, I had the opportunity to work with one of the leading Asset Management Companies in India and gain extensive experience across various aspects of the mutual fund business.
        </p>
        <p>
          In my last assignment, I was responsible for heading the Sales Management function, where I gained valuable insights into investor needs, market dynamics, and the importance of building long-term relationships based on trust and transparency.
        </p>
        <p>
          Today, I bring this experience to my role as a Mutual Fund Distributor, with the objective of helping retail investors navigate their investment journey with greater clarity and confidence. My approach is centred around understanding an investor's goals, providing relevant information, and enabling them to make well-informed investment decisions suited to their individual needs.
        </p>
        <p>
          I believe that successful investing is not just about selecting investments—it is about having the right understanding, maintaining discipline, and staying focused on long-term financial goals. My endeavour is to be a trusted partner in your investment journey.
        </p>
      </div>
    </div>
  </section>

  <!-- Solutions summary -->
  <section class="mx-auto max-w-6xl px-4 sm:px-6 py-14 sm:py-20">
    <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 text-center mb-10">Distribution Solutions</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
      {schemeCards.map((card) => (
        <SectionCard title={card.title}>{card.desc}</SectionCard>
      ))}
    </div>
    <ComplianceCallout label="Regular Plan Notice">
      All mutual fund transactions are executed in Regular Plans. Distribution commissions are received directly from Asset Management Companies as per statutory limits.
    </ComplianceCallout>
  </section>

  <!-- Contact -->
  <section id="contact" class="bg-surface border-y border-slate-200 py-14 sm:py-20">
    <div class="mx-auto max-w-5xl px-4 sm:px-6">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 text-center mb-10">Get in Touch</h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <div class="rounded-xl border border-slate-200 bg-white p-6 sm:p-8 flex flex-col justify-center gap-4">
          <p class="text-sm font-semibold text-accent uppercase tracking-wide">Prefer an Instant Conversation?</p>
          <p class="text-slate-700">Pick a time slot on our calendar for a direct 1:1 conversation.</p>
          <a href={url('schedule')} class="min-h-[44px] inline-flex items-center justify-center px-5 py-2.5 rounded-lg bg-slate-900 text-white text-sm font-semibold hover:bg-slate-800 transition w-fit">
            Schedule a Meeting
          </a>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6 sm:p-8">
          <ContactForm formName="Homepage Inquiry" submitLabel="Submit Inquiry" showGoalFields />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
