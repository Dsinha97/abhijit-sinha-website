---
import BaseLayout from '../layouts/BaseLayout.astro';
import DataTable from '../components/DataTable.astro';
import SectionCard from '../components/SectionCard.astro';
import ComplianceCallout from '../components/ComplianceCallout.astro';
import { distributor, commissionSchedule, commissionPeriod, empanelledAmcs, rateCardAmcs } from '../data/site';
import { url } from '../lib/url';

const tableRows = commissionSchedule.map((r) => [r.assetClass, r.subCategories, r.year1, r.year2Plus]);

const conductGrid = [
  { title: 'Suitability-First Approach', desc: 'Ensuring every recommended scheme aligns with the client\'s documented financial goals, liquidity needs, and risk profile.' },
  { title: 'Conflict of Interest Mitigation', desc: 'Maintaining complete operational independence. No scheme is recommended based on higher distributor payout incentives.' },
  { title: 'Transparent Documentation', desc: 'Ensuring investors receive complete scheme information, Key Information Memorandums (KIM), and Scheme Information Documents (SID) prior to transaction execution.' },
];
---

<BaseLayout
  title="Regulatory Disclosures & Commission Structure | Abhijit Sinha (ARN-367596)"
  description="Statutory disclosures, remuneration structure, and regulatory compliance details for AMFI-registered Mutual Fund Distributor Abhijit Sinha."
>
  <section class="mx-auto max-w-6xl px-4 sm:px-6 py-14 sm:py-20">
    <p class="text-xs font-semibold tracking-wide text-accent uppercase mb-2">Regulatory Transparency</p>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mb-4">Statutory Disclosures & Remuneration Structure</h1>
    <p class="text-slate-600 max-w-3xl">
      In accordance with SEBI circular SEBI/IMD/CIR No. 4/168230/09 and the AMFI Code of Conduct, mutual fund distributors are required to disclose their business model, plan execution type, and all commission rates received from Asset Management Companies (AMCs) to prospective and existing investors.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-4 sm:px-6 pb-14 sm:pb-20">
    <h2 class="text-2xl font-bold text-slate-900 mb-6">How Mutual Fund Distribution Remuneration Works</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <SectionCard title="100% Trail-Only Structure">
        Remuneration is paid solely via trail commissions disbursed by respective Asset Management Companies (AMCs) out of the scheme's Total Expense Ratio (TER). No upfront commissions, advisory fees, or platform handling charges are levied directly on the investor.
      </SectionCard>
      <SectionCard title="Regular Plan Execution">
        All transactions facilitated under {distributor.arn} are executed in Regular Plans. Investors have the option to invest directly with AMCs in Direct Plans, which carry lower expense ratios due to the absence of distribution commissions.
      </SectionCard>
      <SectionCard title="Independent Allocation">
        Fund categories and scheme suggestions are determined strictly by investor suitability, investment horizon, and risk tolerance. Commission differentials across AMCs or asset classes do not influence scheme selection.
      </SectionCard>
      <SectionCard title="CAS Verification">
        The exact gross commission paid to the distributor for your specific portfolio is transparently reported on your monthly or half-yearly Consolidated Account Statement (CAS) issued by depositories (NSDL/CDSL) or RTAs (CAMS/KFintech).
      </SectionCard>
    </div>
  </section>

  <section class="bg-surface border-y border-slate-200 py-14 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="text-2xl font-bold text-slate-900 mb-2">Annual Trail Commission Schedule</h2>
      <p class="text-sm text-slate-500 mb-2">
        Ranges below are the lowest and highest base trail commission payable across every scheme in the
        published rate cards held on file, for the period {commissionPeriod}. Those cards are the ones
        issued by {rateCardAmcs.map((amc) => amc.name).join(', ')}.
      </p>
      <p class="text-sm text-slate-500 mb-6">
        Rate cards for the remaining empanelled Asset Management Companies have not yet been received.
        Their schemes are <strong>not</strong> reflected in the ranges below, and this schedule will be
        updated as each card is received.
      </p>
      <DataTable
        headers={['Asset Class / Classification', 'Sub-Categories Included', 'Trail Commission (Years 1–3)', 'Trail Commission (Year 4 Onwards)']}
        rows={tableRows}
        caption="Annual trail commission schedule by asset class, across the AMCs whose current rate cards are on file"
      />
      <div class="text-xs text-slate-500 mt-4 space-y-2 max-w-4xl">
        <p>
          All figures are <strong>base trail commission per annum, excluding GST</strong>, calculated by each AMC on the
          daily average assets held under ARN-367596 and paid monthly in arrears. GST is charged separately at
          the applicable statutory rate.
        </p>
        <p>
          The year at which the rate steps down varies by AMC — some reduce from year 4, others from year 5, and
          some hold a single rate throughout. The two columns show the higher early-year band and the
          longer-holding band respectively.
        </p>
        <p>
          AMCs revise these rate cards periodically and at their own discretion, and rates are also revised
          downward automatically if a scheme's Total Expense Ratio falls. No commission of any kind is payable
          on Direct Plans.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 sm:px-6 py-14 sm:py-20">
    <h2 class="text-2xl font-bold text-slate-900 mb-2">Empanelled Asset Management Companies</h2>
    <p class="text-sm text-slate-500 mb-6 max-w-3xl">
      {distributor.name} is empanelled as a distributor with the {empanelledAmcs.length} Asset Management
      Companies below under {distributor.arn}.
    </p>

    {/* A fixed white tile per mark, with object-contain and a per-logo max
        height, is what makes aspect ratios from 2:1 to 5.9:1 read as one band
        without distorting any of them — see the note above `empanelledAmcs` in
        site.ts.

        The 9rem (144px) width cap is load-bearing, not decoration. Every `maxH`
        was picked against a tile whose usable width was 144px, where marks past
        ~4:1 hit the width limit before the height limit. This grid's tiles are
        wider than that at desktop, so without the cap those marks stop being
        width-limited and blow out to ~6500px² against ~4700px² for the compact
        ones — measurably lopsided, since the eye compares area. Capping the
        width makes every breakpoint behave like the tile the values were tuned
        for.

        A grid, never a horizontal strip: nothing on this site scrolls sideways
        (docs/wiki/mobile-viewport-pitfalls.md). */}
    <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
      {empanelledAmcs.map((amc) => (
        <li class="flex h-20 items-center justify-center rounded-lg border border-slate-200 bg-white p-2">
          {amc.logo ? (
            <img
              src={url(amc.logo)}
              alt={amc.name}
              width="160"
              height="80"
              loading="lazy"
              decoding="async"
              class:list={['w-auto max-w-[min(100%,9rem)] object-contain', amc.maxH]}
            />
          ) : (
            <span class="text-center text-sm font-semibold leading-tight text-primary">{amc.name}</span>
          )}
        </li>
      ))}
    </ul>

    <p class="mt-4 text-xs text-slate-500 max-w-3xl">
      Empanelment is a distribution arrangement and does not constitute a recommendation of any scheme or
      Asset Management Company. All logos and trademarks are the property of their respective owners.
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-4 sm:px-6 py-14 sm:py-20">
    <h2 class="text-2xl font-bold text-slate-900 mb-2">Additional B-30 and Women Investor Incentive</h2>
    <p class="text-sm text-slate-500 mb-6">
      Beyond the trail commission above, AMCs pay a one-time incentive on certain first-time investments.
      It is disclosed here in full because it is a payment the distributor receives in connection with your
      investment.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <SectionCard title="What Is Payable">
        Under SEBI circular HO/(83)2025-IMD-POD-1/I/152/2025 dated 27 November 2025, effective 1 March 2026,
        an additional incentive of 1% of the first investment — capped at ₹2,000 — is payable on onboarding a
        new investor from a B-30 (beyond top-30) city or a woman investor, in each case a PAN new to the mutual
        fund industry. For SIPs it is 1% of the total invested in the first year, subject to the same ₹2,000 cap.
      </SectionCard>
      <SectionCard title="Conditions and Exclusions">
        The incentive is paid only after the investment completes one year, and lapses on full redemption,
        switch-out, or a change of distributor within that year. It does not apply to investments held in a
        minor's name, to Exchange Traded Funds, to domestic Fund-of-Funds investing over 80% in domestic
        schemes, or to Overnight, Liquid, Ultra Short Duration and Low Duration funds.
      </SectionCard>
    </div>
    <p class="text-xs text-slate-500 italic mt-4 max-w-4xl">
      This incentive is determined entirely by an investor's location, gender and prior investment history — not
      by scheme selection — and therefore does not influence which scheme is discussed with any investor.
      B-30 classification follows the T-30 pin code list published by AMFI.
    </p>
  </section>

  <section class="bg-surface border-y border-slate-200 py-14 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 class="text-2xl font-bold text-slate-900 mb-6">Professional Standards & Regulatory Adherence</h2>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      {conductGrid.map((item) => <SectionCard title={item.title}>{item.desc}</SectionCard>)}
    </div>
    </div>
  </section>

  <section class="bg-surface border-y border-slate-200 py-14 sm:py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <h2 class="text-2xl font-bold text-slate-900 mb-6">Official Distributor Credentials</h2>
      <div class="rounded-xl border border-slate-200 bg-white p-6 space-y-2 text-sm text-slate-700">
        <p><strong class="text-slate-900">Distributor Name:</strong> {distributor.name}</p>
        <p><strong class="text-slate-900">AMFI Registration Number:</strong> {distributor.arn}</p>
        <p><strong class="text-slate-900">EUIN:</strong> {distributor.euin}</p>
        <p><strong class="text-slate-900">Current ARN Validity:</strong> {distributor.arnValidity}</p>
        <p><strong class="text-slate-900">Certification:</strong> {distributor.certification}</p>
        <p><strong class="text-slate-900">Principal Place of Business:</strong> {distributor.officeCity}</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 sm:px-6 py-14 sm:py-20">
    <ComplianceCallout label="Distributor Disclaimer">
      {distributor.name} is an AMFI-registered Mutual Fund Distributor ({distributor.arn}). The schemes and asset categories mentioned are for informational and distribution purposes only. Past performance does not guarantee future results.
    </ComplianceCallout>
  </section>
</BaseLayout>
