---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionCard from '../components/SectionCard.astro';
import ComplianceCallout from '../components/ComplianceCallout.astro';
import Calculators from '../components/Calculators.astro';
import { url } from '../lib/url';

const assetClasses = [
  {
    title: 'Long-Term Wealth Accumulation (Equity Schemes)',
    horizon: '5 to 7+ Years',
    risk: 'High / Moderately High',
    objective: 'Capital growth to outpace inflation for long-term goals like retirement or children’s higher education.',
    subCategories: [
      'Flexi Cap & Multi Cap Funds — broad market exposure across large, mid, and small-cap companies',
      'Large & Mid Cap Funds — stability of established leaders with mid-market growth potential',
      'Large Cap & Index Solutions — core stability tracking bellwether indices',
      'Tax-Saving Schemes (ELSS) — equity exposure with tax deduction benefits under Section 80C',
    ],
    allocation: '60% Large Cap / 40% Mid-Small Cap (placeholder)',
  },
  {
    title: 'Balanced Growth & Downside Cushion (Hybrid Schemes)',
    horizon: '3 to 5 Years',
    risk: 'Moderate / Moderately High',
    objective: 'Capital appreciation with lower volatility by combining equity and debt assets dynamically.',
    subCategories: [
      'Dynamic Asset Allocation / Balanced Advantage Funds (BAF) — automated equity-debt rebalancing',
      'Multi-Asset Allocation Funds — diversification across equity, fixed income, gold, and more',
      'Aggressive / Conservative Hybrid Funds — fixed allocation mixes matching risk appetite',
    ],
    allocation: '65% Equity / 35% Debt & Gold (placeholder)',
  },
  {
    title: 'Income Generation & Capital Preservation (Debt Schemes)',
    horizon: '1 to 3 Years',
    risk: 'Low to Moderate',
    objective: 'Steady returns, liquidity, and portfolio stability with minimal equity market exposure.',
    subCategories: [
      'Corporate Bond & Banking / PSU Funds — high credit quality portfolios',
      'Short Duration & Low Duration Funds — managing interest rate risk',
      'Money Market Funds — short-term fixed income instruments',
    ],
    allocation: '100% High-Grade Fixed Income Instruments (placeholder)',
  },
  {
    title: 'Short-Term Liquidity & Contingency Parking (Liquid Schemes)',
    horizon: '1 Day to 1 Year',
    risk: 'Very Low / Low',
    objective: 'High liquidity and capital preservation for emergency funds and short-term cash deployment.',
    subCategories: [
      'Liquid Funds — 7-day to 91-day paper for surplus operational cash',
      'Overnight Funds — 1-day maturity paper for zero credit and interest rate risk',
      'Ultra Short Duration Funds — 3 to 6 months parking with convenient withdrawal',
    ],
    allocation: 'STP into Equity/Hybrid Funds (placeholder deployment route)',
  },
];

const steps = [
  { title: 'Financial Goal Discovery', desc: 'We map your specific milestone, timeline, and cash flow requirements.' },
  { title: 'Risk-Horizon Alignment', desc: 'We match your comfort with volatility to the appropriate asset class category.' },
  { title: 'Systematic Execution & Review', desc: 'We set up disciplined SIP/STP transactions and review portfolio progress annually.' },
];
---

<BaseLayout
  title="Mutual Fund Solutions & Asset Allocation | Abhijit Sinha (ARN-367596)"
  description="Explore goal-aligned mutual fund solutions across equity, hybrid, debt, and liquid asset classes structured for long-term financial milestones."
>
  <section class="mx-auto max-w-6xl px-4 sm:px-6 py-14 sm:py-20">
    <p class="text-xs font-semibold tracking-wide text-accent uppercase mb-2">Mutual Fund Solutions</p>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mb-4">Goal-Aligned Mutual Fund Portfolios</h1>
    <p class="text-slate-600 max-w-2xl mb-6">
      We organize mutual fund investments around defined life milestones, time horizons, and risk tolerance. Every solution focuses on structured asset allocation rather than speculative market timing.
    </p>
    <ComplianceCallout label="Mandatory Regular Plan Notice">
      Notice: All mutual fund transactions facilitated through this platform are executed under Regular Plans. Distribution commissions are received directly from Asset Management Companies (AMCs) as per statutory limits.
    </ComplianceCallout>
  </section>

  <section class="mx-auto max-w-6xl px-4 sm:px-6 pb-14 sm:pb-20 grid grid-cols-1 lg:grid-cols-2 gap-6">
    {assetClasses.map((cls) => (
      <SectionCard title={cls.title}>
        <div class="space-y-3">
          <div class="flex flex-wrap gap-4 text-xs text-slate-500">
            <span><strong class="text-slate-700">Horizon:</strong> {cls.horizon}</span>
            <span><strong class="text-slate-700">Risk:</strong> {cls.risk}</span>
          </div>
          <p>{cls.objective}</p>
          <ul class="list-disc list-inside space-y-1">
            {cls.subCategories.map((s) => <li>{s}</li>)}
          </ul>
          <p class="text-xs text-slate-400 italic">Suggested allocation: {cls.allocation}</p>
        </div>
      </SectionCard>
    ))}
  </section>

  <section class="bg-surface border-y border-slate-200 py-14 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 text-center mb-10">How We Structure Your Portfolio</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {steps.map((s, i) => (
          <div class="text-center">
            <div class="mx-auto mb-3 h-10 w-10 rounded-full bg-slate-900 text-white flex items-center justify-center font-bold">{i + 1}</div>
            <h3 class="font-semibold text-slate-900 mb-1">{s.title}</h3>
            <p class="text-sm text-slate-600">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-20">
    <div class="text-center max-w-2xl mx-auto mb-10 px-4">
      <h2 class="text-3xl font-bold text-slate-900 mb-3">Plan Your Compounding Journey</h2>
      <p class="text-sm text-slate-600">
        Estimate the future value of your Systematic Investment Plans (SIP) or calculate the monthly savings required to hit a specific financial milestone.
      </p>
    </div>
    <div class="px-4 sm:px-6">
      <Calculators />
    </div>
  </section>

  <section class="bg-surface border-t border-slate-200 py-14 sm:py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 text-center">
      <h2 class="text-2xl font-bold text-slate-900 mb-3">Not Sure Which Scheme Category Fits Your Horizon?</h2>
      <p class="text-slate-600 mb-6">Schedule an introductory conversation to evaluate your investment goals and risk profile.</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href={url('schedule')} class="min-h-[44px] inline-flex items-center justify-center px-5 py-2.5 rounded-lg bg-slate-900 text-white text-sm font-semibold hover:bg-slate-800 transition">
          Schedule a 1:1 Discussion
        </a>
        <a href={url('disclosures')} class="min-h-[44px] inline-flex items-center justify-center px-5 py-2.5 rounded-lg border border-slate-300 text-slate-700 text-sm font-semibold hover:bg-slate-50 transition">
          Review Statutory Disclosures
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
