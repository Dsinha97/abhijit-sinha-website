---
/**
 * TEMPORARY diagnostic page for the mobile horizontal-scroll report.
 *
 * Not linked from anywhere and noindex'd. It reproduces BaseLayout's chrome
 * exactly - sticky header, footer, floating WhatsApp button, privacy notice -
 * because the overflow does not reproduce in desktop emulation and the chrome
 * is the prime suspect. The script measures the real device and prints the
 * numbers on screen so they can be read off a phone with no devtools.
 *
 * DELETE THIS FILE once the cause is identified.
 */
import '../styles/global.css';
import RegulatoryStrip from '../components/RegulatoryStrip.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import PrivacyNotice from '../components/PrivacyNotice.astro';
import { url } from '../lib/url';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <link rel="icon" type="image/png" href={url('images/logo.png')} />
    <title>Layout diagnostic</title>
  </head>
  <body class="bg-white text-slate-900 min-h-screen flex flex-col font-sans antialiased">
    <div id="site-header" class="group z-40 sticky top-0">
      <RegulatoryStrip />
      <Header />
    </div>

    <main id="main-content" class="flex-1">
      <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6">
        <h1 class="text-2xl font-bold">Layout diagnostic</h1>
        <p class="mt-2 text-sm text-slate-600">
          Screenshot everything below. Then try swiping sideways and press the button.
        </p>

        <button
          id="remeasure"
          type="button"
          class="mt-4 min-h-[44px] rounded-lg bg-slate-900 px-4 text-sm font-medium text-white"
        >
          Re-measure now
        </button>

        <pre
          id="out"
          class="mt-4 overflow-x-auto whitespace-pre-wrap break-words rounded-xl border border-slate-300 bg-slate-50 p-3 text-[11px] leading-snug"
        >measuring…</pre>
      </section>
    </main>

    <Footer />
    <WhatsAppButton />
    <PrivacyNotice />

    <script>
      const out = document.getElementById('out');

      function describe(el: Element): string {
        const cls = String((el as HTMLElement).className || '').slice(0, 60);
        return el.tagName.toLowerCase() + (cls ? '.' + cls.replace(/\s+/g, '.') : '');
      }

      function measure(): void {
        if (!out) return;
        const de = document.documentElement;
        const vw = de.clientWidth;
        const lines: string[] = [];

        const vv = window.visualViewport;
        lines.push('clientWidth      ' + vw);
        lines.push('innerWidth       ' + window.innerWidth);
        lines.push('html.scrollWidth ' + de.scrollWidth);
        lines.push('body.scrollWidth ' + document.body.scrollWidth);
        lines.push('scrollX / max    ' + Math.round(window.scrollX) + ' / ' + (de.scrollWidth - vw));
        lines.push('visualViewport   ' + (vv ? Math.round(vv.width) + ' scale=' + vv.scale.toFixed(2) : 'n/a'));
        lines.push('devicePixelRatio ' + window.devicePixelRatio);
        lines.push('html overflow-x  ' + getComputedStyle(de).overflowX);
        lines.push('');

        // Everything sticking out past the right edge, in DOCUMENT coordinates
        // so a horizontal scroll offset does not hide the culprit. Fixed
        // elements are included and flagged rather than filtered out - the
        // whole question is whether one of them is responsible.
        const found: string[] = [];
        for (const el of Array.from(document.querySelectorAll('body *'))) {
          const r = el.getBoundingClientRect();
          const right = Math.round(r.right + window.scrollX);
          if (right > vw + 1 && r.width > 0 && r.height > 0) {
            const pos = getComputedStyle(el).position;
            found.push(right + 'px ' + (pos === 'static' ? '' : '[' + pos + '] ') + describe(el));
          }
        }
        found.sort((a, b) => Number.parseInt(b, 10) - Number.parseInt(a, 10));

        lines.push('OVERFLOWING (' + found.length + '), widest first:');
        lines.push(found.length ? found.slice(0, 15).join('\n') : '  none');

        out.textContent = lines.join('\n');
      }

      document.getElementById('remeasure')?.addEventListener('click', measure);
      window.addEventListener('load', measure);
      measure();
    </script>
  </body>
</html>
