---
import AdminLayout from '../../layouts/AdminLayout.astro';

const inputClass =
  'w-full min-h-[44px] rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30';
const labelClass = 'block text-sm font-medium text-slate-800';
---

<AdminLayout title="Knowledge Corner" active="knowledge">
  <div class="pb-24">
  <!-- Publish bar -->
  <div
    class="flex flex-wrap items-center gap-3 rounded-xl border border-slate-200 bg-white p-4"
  >
    <div class="min-w-0 flex-1">
      <p class="font-semibold text-slate-900">Site builds</p>
      <p class="text-sm text-slate-600">
        Publishing or deleting an item rebuilds the site automatically &mdash; visitors see the
        change in about a minute or two. Use the button only to force a rebuild.
      </p>
      <p id="last-publish" class="mt-1 text-xs text-slate-500"></p>
      <p
        id="publish-pending"
        class="hidden mt-2 rounded-lg border border-amber-300 bg-amber-50 px-3 py-2 text-sm font-medium text-amber-900"
        role="status"
      >
      </p>
    </div>
    <div class="flex flex-col items-end gap-1">
      <button
        id="publish-site"
        type="button"
        class="min-h-[44px] rounded-lg bg-slate-900 px-5 text-sm font-medium text-white transition hover:bg-slate-800 disabled:opacity-50"
      >
        Rebuild site now
      </button>
      <span id="publish-status" class="text-xs text-slate-500"></span>
    </div>
  </div>

  <!-- Articles -->
  <section class="mt-6">
    <h2 class="text-lg font-bold text-slate-900">Articles</h2>
    <ul id="post-list" class="mt-3 space-y-2"></ul>

    <div id="post-editor" class="mt-4 rounded-xl border border-slate-200 bg-white p-5">
      <div class="flex items-center gap-3">
        <h3 id="post-editor-title" class="font-semibold text-slate-900">New article</h3>
        <button
          id="post-cancel"
          type="button"
          class="hidden ml-auto min-h-[44px] rounded-lg border border-slate-300 px-3 text-sm font-medium text-slate-700 hover:bg-slate-50"
        >
          Cancel edit
        </button>
      </div>

      <div class="mt-4 grid grid-cols-1 gap-4 lg:grid-cols-2">
        <div class="space-y-3">
          <div>
            <label class={labelClass} for="post-title">Title</label>
            <input id="post-title" type="text" class={inputClass} />
          </div>
          <div>
            <label class={labelClass} for="post-slug">URL slug</label>
            <input id="post-slug" type="text" class={inputClass} placeholder="why-sips-work" />
            <p class="mt-1 text-xs text-slate-500">
              Lowercase letters, numbers and hyphens only. Changing this on a published article
              breaks its existing link.
            </p>
          </div>
          <div>
            <label class={labelClass} for="post-excerpt">Summary</label>
            <textarea id="post-excerpt" rows="2" class={inputClass}></textarea>
          </div>
          <div>
            <label class={labelClass} for="post-seo">Search description</label>
            <input id="post-seo" type="text" class={inputClass} />
          </div>
          <div>
            <label class={labelClass} for="post-tags">Tags</label>
            <input id="post-tags" type="text" class={inputClass} placeholder="SIP, Basics" />
          </div>
          <div>
            <label class={labelClass} for="post-body">Body (Markdown)</label>
            <textarea
              id="post-body"
              rows="16"
              class="w-full rounded-lg border border-slate-300 px-3 py-2 font-mono text-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30"
            ></textarea>
            <p class="mt-1 text-xs text-slate-500">
              Markdown only. Raw HTML is stripped when the page is built, so pasted embeds and
              scripts will not appear.
            </p>
          </div>
        </div>

        <div class="space-y-3">
          <p class={labelClass}>Preview</p>
          <div
            id="post-preview"
            class="prose prose-slate max-w-none rounded-lg border border-slate-200 bg-surface p-4 text-sm"
          >
          </div>

          <div>
            <p class={labelClass}>Compliance check</p>
            <div id="post-lint" class="mt-1"></div>
          </div>

          <label class="flex items-start gap-2 rounded-lg border border-slate-200 bg-surface p-3">
            <input id="post-ack" type="checkbox" class="mt-1 h-4 w-4" />
            <span class="text-sm text-slate-700">
              I confirm this article contains no personalised investment advice, no guarantee or
              projection of returns, and no recommendation of a specific scheme.
            </span>
          </label>

          <div class="flex flex-wrap gap-2">
            <button
              id="post-save-draft"
              type="button"
              class="min-h-[44px] rounded-lg border border-slate-300 px-4 text-sm font-medium text-slate-700 hover:bg-slate-50"
            >
              Save as draft
            </button>
            <button
              id="post-publish"
              type="button"
              class="min-h-[44px] rounded-lg bg-slate-900 px-4 text-sm font-medium text-white transition hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-50"
            >
              Publish article
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Videos -->
  <section class="mt-8">
    <h2 class="text-lg font-bold text-slate-900">Videos</h2>
    <ul id="video-list" class="mt-3 space-y-2"></ul>

    <div class="mt-4 rounded-xl border border-slate-200 bg-white p-5">
      <h3 class="font-semibold text-slate-900">Add a video</h3>
      <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-3">
        <input id="video-title" type="text" placeholder="Title" class={inputClass} />
        <input
          id="video-url"
          type="url"
          placeholder="https://www.youtube.com/watch?v=..."
          class={inputClass}
        />
        <input id="video-desc" type="text" placeholder="Short description" class={inputClass} />
      </div>
      <button
        id="video-add"
        type="button"
        class="mt-3 min-h-[44px] rounded-lg bg-slate-900 px-4 text-sm font-medium text-white hover:bg-slate-800"
      >
        Add as draft
      </button>
      <p class="mt-2 text-xs text-slate-500">
        YouTube links only. Videos are embedded through youtube-nocookie and load only after a
        visitor clicks play.
      </p>
    </div>
  </section>

  <!-- Reading links -->
  <section class="mt-8">
    <h2 class="text-lg font-bold text-slate-900">Further reading links</h2>
    <ul id="link-list" class="mt-3 space-y-2"></ul>

    <div class="mt-4 rounded-xl border border-slate-200 bg-white p-5">
      <h3 class="font-semibold text-slate-900">Add a link</h3>
      <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2">
        <input id="link-title" type="text" placeholder="Article title" class={inputClass} />
        <input id="link-url" type="url" placeholder="https://..." class={inputClass} />
        <input id="link-source" type="text" placeholder="Source (e.g. AMFI)" class={inputClass} />
        <input id="link-note" type="text" placeholder="Why it is worth reading" class={inputClass} />
      </div>
      <button
        id="link-add"
        type="button"
        class="mt-3 min-h-[44px] rounded-lg bg-slate-900 px-4 text-sm font-medium text-white hover:bg-slate-800"
      >
        Add as draft
      </button>
      <p class="mt-2 text-xs text-slate-500">
        Linked material is shown as reference, never as an endorsement. The public page says so.
      </p>
    </div>
  </section>
  </div>

  {/* Hovering rebuild prompt. Appears whenever saved content has not reached
      the public site yet, and stays out of the way otherwise. Dismissing it
      hides it until the next change - it is a reminder, not a blocker. */}
  <div
    id="rebuild-bar"
    role="status"
    class="hidden fixed inset-x-0 bottom-0 z-50 border-t border-amber-300 bg-amber-50/95 backdrop-blur-sm"
  >
    <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-3 px-4 py-3 sm:px-6">
      <p class="min-w-0 flex-1 text-sm text-amber-900">
        <span class="font-semibold">Changes not on the site yet.</span>
        <span id="rebuild-bar-detail" class="ml-1"></span>
      </p>
      <button
        id="rebuild-bar-go"
        type="button"
        class="min-h-[44px] rounded-lg bg-slate-900 px-4 text-sm font-medium text-white transition hover:bg-slate-800 disabled:opacity-50"
      >
        Rebuild site now
      </button>
      <button
        id="rebuild-bar-close"
        type="button"
        aria-label="Dismiss"
        class="inline-flex h-11 w-11 items-center justify-center rounded-lg text-amber-900 transition hover:bg-amber-100"
      >
        <svg viewBox="0 0 20 20" class="h-5 w-5 fill-current" aria-hidden="true">
          <path d="m10 8.6 4.3-4.3 1.4 1.4L11.4 10l4.3 4.3-1.4 1.4L10 11.4l-4.3 4.3-1.4-1.4L8.6 10 4.3 5.7l1.4-1.4L10 8.6Z" />
        </svg>
      </button>
    </div>
  </div>
</AdminLayout>

<script>
  import '../../scripts/admin/knowledge';
</script>
