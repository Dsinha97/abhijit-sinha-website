---
import AdminLayout from '../../layouts/AdminLayout.astro';

const tiles = [
  { id: 'tile-pageviews', label: 'Page views' },
  { id: 'tile-sessions', label: 'Visitors' },
  { id: 'tile-clicks', label: 'Link clicks' },
  { id: 'tile-bounce', label: 'Single-page visits' },
];
---

<AdminLayout title="Website Metrics" active="analytics">
  <div id="range-picker" class="flex flex-wrap gap-2"></div>

  <div class="mt-4 grid grid-cols-2 gap-4 lg:grid-cols-4">
    {
      tiles.map((t) => (
        <div class="rounded-xl border border-slate-200 bg-white p-4">
          <p class="text-2xl font-bold text-slate-900" id={t.id}>&mdash;</p>
          <p class="mt-1 text-sm text-slate-600">{t.label}</p>
        </div>
      ))
    }
  </div>

  <div class="mt-4 rounded-xl border border-slate-200 bg-white p-5">
    <h2 class="font-semibold text-slate-900">Traffic over time</h2>
    <p class="text-xs text-slate-500">Solid: page views. Dashed: distinct visitors.</p>
    <div id="chart-daily" class="mt-3"></div>
  </div>

  <div class="mt-4 grid grid-cols-1 gap-4 lg:grid-cols-2">
    <div class="rounded-xl border border-slate-200 bg-white p-5">
      <h2 class="font-semibold text-slate-900">Most visited pages</h2>
      <div id="list-pages" class="mt-3"></div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5">
      <h2 class="font-semibold text-slate-900">Most clicked links and buttons</h2>
      <div id="list-clicks" class="mt-3"></div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5">
      <h2 class="font-semibold text-slate-900">Where visitors came from</h2>
      <div id="list-referrers" class="mt-3"></div>
    </div>
    <div class="rounded-xl border border-slate-200 bg-white p-5">
      <h2 class="font-semibold text-slate-900">Devices</h2>
      <div id="chart-devices" class="mt-3"></div>
    </div>
  </div>

  <p class="mt-6 max-w-3xl text-xs text-slate-500">
    Measurement is first-party and cookieless. No IP address, browser user-agent, location or
    advertising identifier is stored, and visitors are not tracked across sites or across days.
    Visits to this admin panel are never recorded. Data is retained for 13 months and this is
    disclosed in the site&rsquo;s Privacy Policy.
  </p>
</AdminLayout>

<script>
  import '../../scripts/admin/analytics';
</script>
