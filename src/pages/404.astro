---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
---

<BaseLayout
  title="Page Not Found | Abhijit Sinha (ARN-367596)"
  description="The page you're looking for doesn't exist."
>
  <section class="mx-auto max-w-2xl px-4 sm:px-6 py-24 text-center">
    <p class="text-sm font-semibold text-accent uppercase tracking-wide mb-2">404</p>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mb-4">Page Not Found</h1>
    <p class="text-slate-600 mb-8">The page you're looking for doesn't exist or may have moved.</p>
    <a href={url('')} class="min-h-[44px] inline-flex items-center justify-center px-5 py-2.5 rounded-lg bg-slate-900 text-white text-sm font-semibold hover:bg-slate-800 transition">
      Back to Homepage
    </a>
  </section>
</BaseLayout>
