---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import RegulatoryStrip from '../components/RegulatoryStrip.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { url } from '../lib/url';

interface Props {
  title: string;
  description: string;
  image?: string;
  // True only on the homepage, whose hero needs the header out of the normal
  // document flow so the banner artwork can run all the way to the top of
  // the page instead of starting below the header's reserved height. Once
  // scrolled even slightly, `sticky` and `fixed` are visually identical (a
  // "stuck" sticky element already behaves exactly like a fixed one) — the
  // *only* difference this makes is at scroll position zero, which is
  // exactly the one case this page needs different.
  overlayHeader?: boolean;
}

const { title, description, image, overlayHeader = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href={url('images/logo.png')} />
    <SEO title={title} description={description} image={image} />
  </head>
  <body class="bg-white text-slate-900 min-h-screen flex flex-col font-sans antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] focus:bg-white focus:text-slate-900 focus:px-4 focus:py-2 focus:rounded-lg focus:shadow-lg"
    >
      Skip to content
    </a>

    <div
      id="site-header"
      class:list={['group z-40', overlayHeader ? 'fixed inset-x-0 top-0' : 'sticky top-0']}
    >
      <RegulatoryStrip overlay={overlayHeader} />
      <Header overlay={overlayHeader} />
    </div>

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <Footer />
    <WhatsAppButton />

    <script>
      // Shrinks the sticky header (regulatory strip + nav) once the page has
      // scrolled a little, via a `data-scrolled` attribute that the Tailwind
      // `group-data-[scrolled]:` variants in Header.astro and
      // RegulatoryStrip.astro key off. Deliberately a plain `group`, not a
      // named "group slash header" modifier: stacking a responsive prefix in
      // front of a named group-data variant produced CSS that Tailwind
      // 3.4.19's JIT scanner generated but that never matched anything (the
      // named-group form needs the literal ancestor class token to stay
      // intact character-for-character everywhere it's referenced, including
      // in prose, which is fragile) — the unnamed form sidesteps that
      // entirely. The check itself is just one attribute
      // get/set — cheap enough to run on every scroll event with no
      // requestAnimationFrame gating. rAF gating was tried and dropped: it
      // makes the toggle silently stop firing whenever rAF is throttled
      // (backgrounded/minimized tabs, some mobile power-saving modes), which
      // is a real failure mode for something this inexpensive to just run
      // directly. scroll-padding-top in global.css is tuned to the shrunken
      // (not expanded) header height, since that's what's on screen by the
      // time any anchor jump matters.
      const headerEl = document.getElementById('site-header');
      const SCROLL_THRESHOLD = 32;

      function updateScrolledState() {
        if (!headerEl) return;
        const isScrolled = window.scrollY > SCROLL_THRESHOLD;
        if (isScrolled) {
          headerEl.setAttribute('data-scrolled', '');
        } else {
          headerEl.removeAttribute('data-scrolled');
        }
      }

      updateScrolledState();
      window.addEventListener('scroll', updateScrolledState, { passive: true });
    </script>

    <script>
      // Keeps the nav's active-page indicator in sync with the homepage's
      // #about section, since it's a same-page anchor rather than a separate
      // route and so can't be determined from the URL the way every other
      // nav item is (see isActiveNavItem in Header.astro, which deliberately
      // leaves hash hrefs unhighlighted on the server-rendered pass — this
      // script is what takes over from there). No-ops entirely on every page
      // other than the homepage, where #about doesn't exist.
      const aboutSection = document.getElementById('about');
      const navLinks = Array.from(document.querySelectorAll('[data-nav-href]'));

      if (aboutSection && navLinks.length) {
        const setActiveHref = (href: string) => {
          navLinks.forEach((el) => {
            if (el.getAttribute('data-nav-href') === href) {
              el.setAttribute('aria-current', 'page');
            } else {
              el.removeAttribute('aria-current');
            }
          });
        };

        const observer = new IntersectionObserver(
          ([entry]) => {
            setActiveHref(entry.isIntersecting ? '/#about' : '/');
          },
          // Top margin roughly matches the shrunk header's height, so About
          // only takes over once it clears the sticky bar rather than the
          // instant it touches the raw viewport edge.
          { rootMargin: '-96px 0px -60% 0px', threshold: 0 }
        );
        observer.observe(aboutSection);
      }
    </script>
  </body>
</html>
