---
/**
 * Standalone shell for /admin.
 *
 * Deliberately does NOT use BaseLayout: the regulatory strip, public nav,
 * footer disclosures and floating WhatsApp button are furniture for visitors,
 * not for a dashboard, and the statutory footer text would be misleading on a
 * page no investor ever sees.
 *
 * Security note: nothing on this page is protected by the host. The site is
 * static, so these files are publicly downloadable. What protects the data is
 * Postgres Row Level Security plus the admin_allowlist table — every query runs
 * as the signed-in user and returns nothing unless is_admin() is true.
 */
import '../styles/global.css';
import { url } from '../lib/url';

interface Props {
  title: string;
  active: 'overview' | 'leads' | 'knowledge' | 'analytics';
}

const { title, active } = Astro.props;

const navItems = [
  { key: 'overview', label: 'Overview', href: 'admin' },
  { key: 'leads', label: 'Requests', href: 'admin/leads' },
  { key: 'knowledge', label: 'Knowledge Corner', href: 'admin/knowledge' },
  { key: 'analytics', label: 'Website Metrics', href: 'admin/analytics' },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Belt and braces alongside robots.txt and the sitemap filter. -->
    <meta name="robots" content="noindex,nofollow,noarchive" />
    <link rel="icon" type="image/png" href={url('images/logo.png')} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-surface text-slate-900 font-sans antialiased">
    <!-- Shown until the auth guard decides what to render, so lead data never
         flashes on screen before the allowlist check completes. -->
    <div id="admin-boot" class="flex min-h-screen items-center justify-center">
      <p class="text-sm text-slate-500">Loading&hellip;</p>
    </div>

    <div id="admin-login" class="hidden min-h-screen items-center justify-center px-4">
      <div class="w-full max-w-sm rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
        <h1 class="text-lg font-bold text-slate-900">Admin sign in</h1>
        <p class="mt-1 text-sm text-slate-600">
          Enter your admin email and we&rsquo;ll send a one-time sign-in link. No password needed.
        </p>

        <form id="login-form" class="mt-5 space-y-3">
          <label class="block text-sm font-medium text-slate-800" for="login-email">Email</label>
          <input
            id="login-email"
            type="email"
            required
            autocomplete="email"
            class="w-full min-h-[44px] rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30"
          />
          <button
            type="submit"
            class="w-full min-h-[44px] rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-slate-800 disabled:opacity-50"
          >
            Send sign-in link
          </button>
        </form>

        <p id="login-msg" class="mt-3 text-sm" role="status" aria-live="polite"></p>
      </div>
    </div>

    <div id="admin-shell" class="hidden">
      <header class="border-b border-slate-200 bg-white">
        <div class="mx-auto flex max-w-7xl flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3 sm:px-6">
          <a href={url('admin')} class="font-bold text-slate-900">Admin</a>

          <nav class="flex flex-wrap gap-x-4 gap-y-1 text-sm" aria-label="Admin sections">
            {
              navItems.map((item) => (
                <a
                  href={url(item.href)}
                  aria-current={active === item.key ? 'page' : undefined}
                  class:list={[
                    'inline-flex min-h-[44px] items-center transition',
                    active === item.key
                      ? 'font-semibold text-slate-900'
                      : 'text-slate-500 hover:text-slate-900',
                  ]}
                >
                  {item.label}
                </a>
              ))
            }
          </nav>

          <div class="ml-auto flex items-center gap-3 text-sm">
            <span id="admin-email" class="hidden text-slate-500 sm:inline"></span>
            <a href={url('')} class="text-slate-500 hover:text-slate-900">View site</a>
            <button
              id="sign-out"
              type="button"
              class="min-h-[44px] rounded-lg border border-slate-300 px-3 text-sm font-medium text-slate-700 transition hover:bg-slate-50"
            >
              Sign out
            </button>
          </div>
        </div>
      </header>

      <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6">
        <h1 class="text-2xl font-bold text-slate-900">{title}</h1>
        <div class="mt-6">
          <slot />
        </div>
      </main>
    </div>

    <div id="admin-denied" class="hidden min-h-screen items-center justify-center px-4">
      <div class="w-full max-w-sm rounded-2xl border border-amber-300 bg-amber-50 p-6 text-center">
        <h1 class="font-bold text-slate-900">Not authorised</h1>
        <p class="mt-2 text-sm text-slate-700">
          This account is signed in but is not on the admin allowlist.
        </p>
        <button
          id="denied-sign-out"
          type="button"
          class="mt-4 min-h-[44px] rounded-lg border border-slate-300 bg-white px-4 text-sm font-medium text-slate-700"
        >
          Sign out
        </button>
      </div>
    </div>

    <script>
      import '../scripts/admin/guard';
    </script>
  </body>
</html>
