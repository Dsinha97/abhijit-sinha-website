---
import { url } from '../lib/url';
import { distributor, statutory, redressalLinks, footerQuickLinks, empanelledAmcs } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="bg-slate-900 text-slate-300 mt-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 py-10 space-y-8">
    <div class="rounded-xl border border-slate-700 bg-slate-800/60 p-4 sm:p-5">
      <p class="text-sm sm:text-base font-semibold text-white">
        {statutory.riskWarning}
      </p>
      <p class="mt-3 text-sm text-slate-300">
        {statutory.regularPlanNotice}
      </p>
    </div>

    <p class="text-sm text-slate-400 max-w-3xl">
      {statutory.distributorDisclaimer}
    </p>

    <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
      {redressalLinks.map((link) => (
        <a href={link.href} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors min-h-[44px] inline-flex items-center">
          {link.label}
        </a>
      ))}
      {footerQuickLinks.map((item) => (
        <a href={url(item.href.replace(/^\//, ''))} class="hover:text-white transition-colors min-h-[44px] inline-flex items-center">
          {item.label}
        </a>
      ))}
      {/* Reopens the privacy notice so a choice can be changed at any time.
          An opt-out a visitor cannot revisit is not much of a choice. */}
      <button
        id="privacy-reopen"
        type="button"
        class="hover:text-white transition-colors min-h-[44px] inline-flex items-center"
      >
        Privacy Choices
      </button>
    </div>

    {/* The logo wall itself lives on /disclosures, directly under the
        commission table it qualifies — fourteen tiles is a page section, not a
        footer block. The non-endorsement wording travels with the claim, so it
        stays here too. */}
    <p class="text-xs text-slate-500 max-w-3xl">
      Empanelled with {empanelledAmcs.length} Asset Management Companies —{' '}
      <a href={url('disclosures')} class="underline underline-offset-2 hover:text-slate-300"
        >see the full list on Disclosures</a
      >. Empanelment is a distribution arrangement and does not constitute a recommendation of any
      scheme or Asset Management Company. All logos and trademarks are the property of their
      respective owners.
    </p>

    <div class="border-t border-slate-700 pt-6 text-xs text-slate-500 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
      <p>
        &copy; {year} {distributor.name}. All rights reserved. AMFI Registration Number: {distributor.arn}. Registered Office: {distributor.officeCity}.
      </p>
      <p>
        <a href={`mailto:${distributor.email}`} class="hover:text-white">{distributor.email}</a>
        {' | '}
        <a href={distributor.phoneHref} class="hover:text-white">{distributor.phone}</a>
      </p>
    </div>
  </div>
</footer>

<script>
  document.getElementById('privacy-reopen')?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('privacy:reopen'));
  });
</script>
