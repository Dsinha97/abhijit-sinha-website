---
import { url } from '../lib/url';
import { distributor, statutory, footerLinks, empanelledAmcs } from '../data/site';

const year = new Date().getFullYear();

// Shared by every entry so the 44px tap target survives whichever element the
// entry renders as — an inline row is visually dense, but the touch target
// stays full height (docs/wiki/design-system.md).
const itemClass = 'hover:text-white transition-colors min-h-[44px] inline-flex items-center';
---

<footer class="bg-slate-900 text-slate-300 mt-16">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 py-10 space-y-8">
    <div class="rounded-xl border border-slate-700 bg-slate-800/60 p-4 sm:p-5">
      <p class="text-sm sm:text-base font-semibold text-white">
        {statutory.riskWarning}
      </p>
      <p class="mt-3 text-sm text-slate-300">
        {statutory.regularPlanNotice}
      </p>
    </div>

    <p class="text-sm text-slate-400 max-w-3xl">
      {statutory.distributorDisclaimer}
    </p>

    {/* The logo wall itself lives on /disclosures, directly under the
        commission table it qualifies — fourteen tiles is a page section, not a
        footer block. The non-endorsement wording travels with the claim, so it
        stays here too. */}
    <p class="text-xs text-slate-500 max-w-3xl">
      Empanelled with {empanelledAmcs.length} Asset Management Companies —{' '}
      <a href={url('disclosures')} class="underline underline-offset-2 hover:text-slate-300"
        >see the full list on Disclosures</a
      >. Empanelment is a distribution arrangement and does not constitute a recommendation of any
      scheme or Asset Management Company. All logos and trademarks are the property of their
      respective owners.
    </p>

    <div class="border-t border-slate-700 pt-6 text-xs text-slate-500 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
      <p>
        &copy; {year} {distributor.name}. All rights reserved. AMFI Registration Number: {distributor.arn}. Registered Office: {distributor.officeCity}.
      </p>
      <p>
        <a href={`mailto:${distributor.email}`} class="hover:text-white">{distributor.email}</a>
        {' | '}
        <a href={distributor.phoneHref} class="hover:text-white">{distributor.phone}</a>
      </p>
    </div>

    {/* A short inline row under the copyright line, not a second navigation —
        see the note on footerLinks in src/data/site.ts. Wraps rather than
        scrolls: nothing in this site may scroll sideways
        (docs/wiki/mobile-viewport-pitfalls.md). The middot separators are
        real elements marked aria-hidden rather than `after:content-['·']`
        arbitrary values: Tailwind's scanner produced no rule at all for the
        escaped-character form, so the separators silently vanished. */}
    <nav aria-label="Footer">
      <ul class="flex flex-wrap items-center gap-x-3 text-xs text-slate-400">
        {footerLinks.map((item, i) => (
          <li class="flex items-center gap-x-3">
            {item.kind === 'external' ? (
              <a href={item.href} target="_blank" rel="noopener noreferrer" class={itemClass}>
                {item.label}
              </a>
            ) : item.kind === 'privacy-choices' ? (
              /* Reopens the privacy notice so a choice can be changed at any
                 time. An opt-out a visitor cannot revisit is not much of a
                 choice. */
              <button id="privacy-reopen" type="button" class={itemClass}>
                {item.label}
              </button>
            ) : (
              <a href={url(item.href.replace(/^\//, ''))} class={itemClass}>
                {item.label}
              </a>
            )}
            {i < footerLinks.length - 1 && <span aria-hidden="true" class="text-slate-600">&middot;</span>}
          </li>
        ))}
      </ul>
    </nav>
  </div>
</footer>

<script>
  document.getElementById('privacy-reopen')?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('privacy:reopen'));
  });
</script>
