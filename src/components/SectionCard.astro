---
interface Props {
  eyebrow?: string;
  title?: string;
}
const { eyebrow, title } = Astro.props;
---

<div class="rounded-xl border border-slate-200 bg-surface p-5 sm:p-6 h-full flex flex-col">
  {eyebrow && <p class="text-xs font-semibold tracking-wide text-accent uppercase mb-1">{eyebrow}</p>}
  {title && <h3 class="text-lg font-bold text-slate-900 mb-2">{title}</h3>}
  <div class="text-sm text-slate-600 flex-1">
    <slot />
  </div>
</div>
