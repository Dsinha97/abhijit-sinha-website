---
// Click-to-load YouTube facade.
//
// Nothing here touches a Google domain until the visitor clicks: no iframe, no
// hotlinked i.ytimg.com poster, no preconnect. The thumbnail is real, but it is
// downloaded at build time by scripts/youtube-thumbnails.mjs and served from
// this origin — hotlinking it would fire, on page load and for every video at
// once, exactly the third-party request this component exists to avoid.
//
// The poster sits on top of the gradient rather than replacing it, so a video
// with no available thumbnail falls back to the gradient with no broken image.
import { youtubeId } from '../../lib/youtube';
import { url } from '../../lib/url';

interface Props {
  title: string;
  description?: string | null;
  videoUrl: string;
}

const { title, description, videoUrl } = Astro.props;
const id = youtubeId(videoUrl);
---

{
  id && (
    <article class="rounded-xl border border-slate-200 bg-white overflow-hidden flex flex-col">
      <div
        class="relative aspect-video bg-slate-900 bg-gradient-to-br from-slate-900 via-slate-800 to-slate-700"
        data-yt-slot
      >
        {/* The poster is an inline background-image on the button, sitting over
            the wrapper's gradient. They must be on separate elements: an inline
            style beats a utility class, so putting both on the button would
            replace the gradient outright and leave nothing to fall back to when
            a poster is missing. The file is fetched at build time and served
            from this origin - see scripts/youtube-thumbnails.mjs - so nothing
            reaches Google before the visitor clicks. */}
        <button
          type="button"
          data-yt-id={id}
          data-track="video"
          data-track-label={title}
          style={`background-image:url('${url(`images/video-thumbs/${id}.jpg`)}')`}
          class="group absolute inset-0 w-full h-full flex flex-col items-center justify-center gap-3 bg-cover bg-center text-white focus:outline-none focus-visible:ring-4 focus-visible:ring-accent/60"
          aria-label={`Play video: ${title}`}
        >
          {/* Scrim: keeps the play control and caption legible over a bright
              thumbnail, and lifts slightly on hover. */}
          <span
            class="absolute inset-0 bg-slate-950/45 transition-colors group-hover:bg-slate-950/30"
            aria-hidden="true"
          ></span>

          <span class="relative flex h-14 w-14 items-center justify-center rounded-full bg-white/20 ring-1 ring-white/40 backdrop-blur-sm transition group-hover:bg-white/30 group-hover:scale-105">
            <svg viewBox="0 0 24 24" class="h-7 w-7 translate-x-[2px] fill-white" aria-hidden="true">
              <path d="M8 5v14l11-7z" />
            </svg>
          </span>
          <span class="relative px-4 text-center text-xs font-medium text-slate-100 drop-shadow">
            Click to play &middot; loads YouTube only on click
          </span>
        </button>
      </div>

      <div class="p-4 flex-1">
        <h3 class="font-semibold text-slate-900 leading-snug">{title}</h3>
        {description && <p class="mt-1.5 text-sm text-slate-600">{description}</p>}
      </div>
    </article>
  )
}

<script>
  // Delegated so one listener covers every card on the page.
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const btn = target.closest('[data-yt-id]');
    if (!(btn instanceof HTMLElement)) return;

    const id = btn.getAttribute('data-yt-id');
    const slot = btn.closest('[data-yt-slot]');
    if (!id || !slot) return;

    const iframe = document.createElement('iframe');
    iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
    iframe.title = btn.getAttribute('aria-label') || 'Video';
    iframe.className = 'absolute inset-0 h-full w-full';
    iframe.loading = 'lazy';
    iframe.referrerPolicy = 'strict-origin';
    iframe.allow = 'accelerometer; autoplay; encrypted-media; picture-in-picture';
    iframe.allowFullscreen = true;

    slot.replaceChildren(iframe);
  });
</script>
