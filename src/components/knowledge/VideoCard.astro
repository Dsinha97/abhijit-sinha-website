---
// Click-to-load YouTube facade.
//
// Nothing here touches a Google domain until the visitor clicks: no iframe, no
// hotlinked i.ytimg.com poster, no preconnect. The thumbnail is real, but it is
// downloaded at build time by scripts/youtube-thumbnails.mjs and served from
// this origin — hotlinking it would fire, on page load and for every video at
// once, exactly the third-party request this component exists to avoid.
//
// The card carries no caption about that: it is a promise the site keeps, not
// something a visitor needs explained on every thumbnail. The behaviour is
// disclosed in Privacy Policy 5.3 for anyone who cares to check.
import { youtubeId } from '../../lib/youtube';
import { url } from '../../lib/url';
import Clamp from './Clamp.astro';

interface Props {
  id: number;
  title: string;
  description?: string | null;
  videoUrl: string;
}

const { id: rowId, title, description, videoUrl } = Astro.props;
const id = youtubeId(videoUrl);
---

{
  id && (
    <article class="flex h-full flex-col overflow-hidden rounded-xl border border-slate-200 bg-white">
      <div
        class="relative aspect-video bg-slate-900 bg-gradient-to-br from-slate-900 via-slate-800 to-slate-700"
        data-yt-slot
      >
        {/* The poster is an inline background-image on the button, sitting over
            the wrapper's gradient. They must be on separate elements: an inline
            style beats a utility class, so putting both on the button would
            replace the gradient outright and leave nothing to fall back to when
            a poster is missing. */}
        <button
          type="button"
          data-yt-id={id}
          data-track="video"
          data-track-label={title}
          style={`background-image:url('${url(`images/video-thumbs/${id}.jpg`)}')`}
          class="group absolute inset-0 flex h-full w-full items-center justify-center bg-cover bg-center focus:outline-none focus-visible:ring-4 focus-visible:ring-accent/60"
          aria-label={`Play video: ${title}`}
        >
          {/* Light scrim: enough to keep the play control visible on a bright
              frame, without dulling the thumbnail itself. */}
          <span
            class="absolute inset-0 bg-slate-950/10 transition-colors group-hover:bg-slate-950/25"
            aria-hidden="true"
          />
          <span class="relative flex h-14 w-14 items-center justify-center rounded-full bg-slate-950/45 ring-1 ring-white/50 backdrop-blur-sm transition group-hover:scale-105 group-hover:bg-slate-950/60">
            <svg viewBox="0 0 24 24" class="h-7 w-7 translate-x-[2px] fill-white" aria-hidden="true">
              <path d="M8 5v14l11-7z" />
            </svg>
          </span>
        </button>
      </div>

      <div class="flex flex-1 flex-col p-4">
        <h3 class="font-semibold leading-snug text-slate-900">{title}</h3>
        {description && (
          <Clamp
            id={`video-desc-${rowId}`}
            text={description}
            class="mt-1.5 text-sm text-slate-600"
          />
        )}
      </div>
    </article>
  )
}

<script>
  // Delegated so one listener covers every card on the page.
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const btn = target.closest('[data-yt-id]');
    if (!(btn instanceof HTMLElement)) return;

    const id = btn.getAttribute('data-yt-id');
    const slot = btn.closest('[data-yt-slot]');
    if (!id || !slot) return;

    const iframe = document.createElement('iframe');
    iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
    iframe.title = btn.getAttribute('aria-label') || 'Video';
    iframe.className = 'absolute inset-0 h-full w-full';
    iframe.loading = 'lazy';
    iframe.referrerPolicy = 'strict-origin';
    iframe.allow = 'accelerometer; autoplay; encrypted-media; picture-in-picture';
    iframe.allowFullscreen = true;

    slot.replaceChildren(iframe);
  });
</script>
