---
import { url } from '../../lib/url';

interface Props {
  slug: string;
  title: string;
  excerpt?: string | null;
  publishedAt?: string | null;
  tags?: string[];
}

const { slug, title, excerpt, publishedAt, tags = [] } = Astro.props;

const dateLabel = publishedAt
  ? new Date(publishedAt).toLocaleDateString('en-IN', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    })
  : null;
---

<article class="rounded-xl border border-slate-200 bg-white p-5 flex flex-col hover:border-slate-300 transition">
  {dateLabel && <p class="text-xs text-slate-500">{dateLabel}</p>}

  <h3 class="mt-1 font-semibold text-slate-900 leading-snug">
    <a
      href={url(`knowledge-corner/${slug}`)}
      class="hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded"
      data-track="nav"
      data-track-label={title}
    >
      {title}
    </a>
  </h3>

  {excerpt && <p class="mt-2 text-sm text-slate-600 flex-1">{excerpt}</p>}

  {
    tags.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-1.5">
        {tags.slice(0, 4).map((tag) => (
          <li class="rounded-full bg-surfaceAlt px-2.5 py-0.5 text-[11px] font-medium text-muted">
            {tag}
          </li>
        ))}
      </ul>
    )
  }
</article>
