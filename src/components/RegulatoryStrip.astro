---
import { distributor } from '../data/site';

interface Props {
  // See the matching prop on Header.astro — true only on the homepage hero.
  overlay?: boolean;
}
const { overlay = false } = Astro.props;
---

<div
  class:list={[
    'w-full text-white text-xs sm:text-sm group-data-[scrolled]:text-[10px] sm:group-data-[scrolled]:text-xs transition-[background-color,font-size] duration-200 motion-reduce:transition-none',
    'group-data-[scrolled]:bg-slate-900',
    overlay ? 'bg-slate-900/70 backdrop-blur-md' : 'bg-slate-900',
  ]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 py-1.5 group-data-[scrolled]:py-0.5 flex flex-wrap items-center justify-between gap-x-4 gap-y-0.5 transition-[padding] duration-200 motion-reduce:transition-none">
    <span>AMFI-Registered Mutual Fund Distributor | {distributor.arn}</span>
    <span>{distributor.certification}</span>
  </div>
</div>
