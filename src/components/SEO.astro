---
// src/components/SEO.astro
import { url } from '../lib/url';
import { distributor, googleBusiness } from '../data/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  /** 'article' for Knowledge Corner posts; every other page is a 'website'. */
  ogType?: string;
  /** Replaces the default FinancialService node. Article pages pass a
   *  BlogPosting so a post is described as content, not as the business. */
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  image = 'images/og-image.jpg',
  ogType = 'website',
  jsonLd,
} = Astro.props;

// Astro.url.pathname already includes the configured base path, so combining
// it with Astro.site's origin (which is base-free) gives the correct
// canonical URL without any manual base-stripping.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(url(image), Astro.site);
---

<!-- Global Metadata -->
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook / WhatsApp -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageURL} />
<meta property="og:site_name" content="Abhijit Sinha | AMFI-Registered MFD" />

<!-- Twitter / X Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImageURL} />

<!-- Structured data: the FinancialService business node by default, or a
     page-specific node (e.g. BlogPosting) when a page supplies one. -->
<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd ?? {
  '@context': 'https://schema.org',
  '@type': 'FinancialService',
  name: `${distributor.name} - AMFI-Registered Mutual Fund Distributor`,
  url: new URL(url(''), Astro.site).toString(),
  logo: new URL(url('images/logo.png'), Astro.site).toString(),
  image: new URL(url('images/banner.png'), Astro.site).toString(),
  description: 'Goal-based mutual fund distribution and disciplined portfolio allocation.',
  identifier: distributor.arn,
  telephone: distributor.phone,
  email: distributor.email,
  // FinancialService is a LocalBusiness subtype, so the address, hours and
  // sameAs fields below are all valid on this node — no second script tag.
  // sameAs is what ties this site to the Google Business Profile and the
  // LinkedIn page as one entity; keep the listing's address byte-identical
  // to distributor.address or the two stop reconciling.
  // Deliberately no aggregateRating/review: the listing has no reviews, and
  // rating markup without reviews behind it is both a structured-data
  // penalty and a misrepresentation on a regulated-content site.
  address: {
    '@type': 'PostalAddress',
    streetAddress: distributor.address.street,
    addressLocality: distributor.address.locality,
    addressRegion: distributor.address.region,
    postalCode: distributor.address.postalCode,
    addressCountry: distributor.address.countryCode,
  },
  openingHours: distributor.officeHours.schema,
  areaServed: { '@type': 'Country', name: 'India' },
  hasMap: googleBusiness.profileUrl,
  sameAs: [googleBusiness.profileUrl, distributor.linkedin],
  founder: {
    '@type': 'Person',
    name: distributor.name,
    jobTitle: 'Mutual Fund Distributor',
    honorificSuffix: 'MBA in Finance',
  },
})}
/>
