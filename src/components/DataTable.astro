---
/**
 * Statutory and reference tables.
 *
 * A cell is either plain text or a list of outbound links. The link form is an
 * array of objects rather than a raw HTML string on purpose: this same
 * component renders the commission schedule on /disclosures and is earmarked
 * for Supabase-sourced content, so no caller can ever inject markup through it.
 */

export type CellLink = { text: string; href: string };
export type Cell = string | CellLink[];

interface Props {
  headers: string[];
  rows: Cell[][];
  caption?: string;
}
const { headers, rows, caption } = Astro.props;
---

<div class="overflow-x-auto rounded-xl border border-slate-200">
  <table class="min-w-full text-sm divide-y divide-slate-200">
    {caption && <caption class="sr-only">{caption}</caption>}
    <thead class="bg-slate-50">
      <tr>
        {headers.map((h) => (
          <th scope="col" class="px-4 py-3 text-left font-semibold text-slate-900 whitespace-nowrap">
            {h}
          </th>
        ))}
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100 bg-white">
      {rows.map((row, i) => (
        <tr class:list={[i % 2 === 1 ? 'bg-slate-50/50' : '']}>
          {row.map((cell) => (
            <td class="px-4 py-3 text-slate-600 align-top">
              {typeof cell === 'string' ? (
                cell
              ) : (
                cell.map((link, j) => (
                  <>
                    {j > 0 && <span aria-hidden="true"> / </span>}
                    {/* `relative` on the anchor is load-bearing, not
                        decoration. The sr-only span inside is
                        position:absolute, and with no positioned ancestor its
                        containing block is the page - so it escapes this
                        table's overflow-x-auto wrapper, lands out at the
                        table's full width and gives the whole document a
                        horizontal scrollbar on a phone. Positioning the anchor
                        keeps it inside the scroll container. */}
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      data-track="resource"
                      data-track-label={link.text}
                      class="relative inline-flex min-h-[44px] items-center rounded text-accent underline underline-offset-2 hover:text-slate-900 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
                    >
                      {link.text}
                      <span class="sr-only">(opens in a new tab)</span>
                    </a>
                  </>
                ))
              )}
            </td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
