---
import { url } from '../lib/url';
import { nav, primaryCta } from '../data/site';

const currentPath = Astro.url.pathname.replace(import.meta.env.BASE_URL, '/');
---

<header class="bg-white border-b border-slate-200">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 h-16 sm:h-20 flex items-center justify-between gap-4">
    <a href={url('')} class="flex items-center gap-2 shrink-0 min-h-[44px]">
      <img src={url('images/logo.png')} alt="Abhijit Sinha logo" class="h-9 w-auto sm:h-11" />
      <span class="hidden sm:flex flex-col leading-tight">
        <span class="font-bold text-slate-900 text-base">Abhijit Sinha</span>
        <span class="text-xs text-slate-500">Mutual Fund Distributor</span>
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-6" aria-label="Primary">
      {nav.map((item) => (
        <a
          href={url(item.href.replace(/^\//, ''))}
          class:list={[
            'text-sm font-medium transition-colors hover:text-slate-900 min-h-[44px] flex items-center',
            currentPath === item.href.split('#')[0] ? 'text-slate-900' : 'text-slate-600',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={url(primaryCta.href.replace(/^\//, ''))}
        class="hidden sm:inline-flex items-center justify-center min-h-[44px] px-4 py-2 rounded-lg bg-slate-900 text-white text-sm font-semibold hover:bg-slate-800 transition-colors"
      >
        {primaryCta.label}
      </a>

      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden inline-flex items-center justify-center h-11 w-11 rounded-lg border border-slate-200 text-slate-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <svg id="icon-open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="lg:hidden hidden border-t border-slate-200 bg-white">
    <nav class="px-4 py-3 flex flex-col" aria-label="Mobile Primary">
      {nav.map((item) => (
        <a
          href={url(item.href.replace(/^\//, ''))}
          class="min-h-[44px] flex items-center text-sm font-medium text-slate-700 hover:text-slate-900 border-b border-slate-100 last:border-b-0"
        >
          {item.label}
        </a>
      ))}
      <a
        href={url(primaryCta.href.replace(/^\//, ''))}
        class="mt-3 min-h-[44px] flex items-center justify-center rounded-lg bg-slate-900 text-white text-sm font-semibold px-4"
      >
        {primaryCta.label}
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  function closeMenu() {
    if (!btn || !menu || !iconOpen || !iconClose) return;
    menu.classList.add('hidden');
    iconOpen.classList.remove('hidden');
    iconClose.classList.add('hidden');
    btn.setAttribute('aria-expanded', 'false');
    btn.setAttribute('aria-label', 'Open menu');
  }

  function openMenu() {
    if (!btn || !menu || !iconOpen || !iconClose) return;
    menu.classList.remove('hidden');
    iconOpen.classList.add('hidden');
    iconClose.classList.remove('hidden');
    btn.setAttribute('aria-expanded', 'true');
    btn.setAttribute('aria-label', 'Close menu');
  }

  btn?.addEventListener('click', () => {
    const isOpen = btn.getAttribute('aria-expanded') === 'true';
    isOpen ? closeMenu() : openMenu();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });

  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));
</script>
