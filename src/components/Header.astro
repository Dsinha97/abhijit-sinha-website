---
import { url } from '../lib/url';
import { nav, primaryCta } from '../data/site';

// Derive the base-free, trailing-slash-free current path so it can be
// compared directly against nav hrefs like "/solutions". Two independent
// slash inconsistencies have to be handled, not just one:
// - import.meta.env.BASE_URL isn't guaranteed to carry a trailing slash (see
//   the same caveat in src/lib/url.ts), so a plain string .replace() against
//   it can leave a doubled leading slash ("//solutions") that never matches
//   anything.
// - Astro's static output renders nested pages as `/solutions/index.html`,
//   so Astro.url.pathname carries a trailing slash there but not on the
//   homepage — that needs stripping too (except when the result is just "/").
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
let currentPath = Astro.url.pathname;
if (base && currentPath.startsWith(base)) currentPath = currentPath.slice(base.length);
if (!currentPath.startsWith('/')) currentPath = '/' + currentPath;
if (currentPath.length > 1) currentPath = currentPath.replace(/\/+$/, '');

// Only distinct pages (not the "/#about" same-page anchor) are highlighted
// from this server-rendered pass — About isn't a separate route, so treating
// it as "active" whenever we're on the homepage would light up both Home and
// About at once on first paint. The homepage's own scroll-spy script (in
// BaseLayout.astro) takes over from here once the page can actually tell
// whether the visitor has scrolled into the About section.
function isActiveNavItem(href: string): boolean {
  if (href.includes('#')) return false;
  return currentPath === href;
}

// Active-item styling now lives entirely in these aria-[current=page]:
// variants rather than being computed per-item in JS/ternaries — the
// scroll-spy script only ever has to flip one attribute, and the
// server-rendered pass and the client-side one both drive the exact same
// CSS. A single-level attribute variant like this also sidesteps the
// group-data-plus-responsive-prefix gap hit elsewhere in this file's history
// (see BaseLayout.astro's scroll-shrink comment) — there's no group/variant
// stacking here to go wrong.
const desktopNavLinkClass =
  'text-sm min-h-[44px] flex items-center border-b-2 border-transparent text-slate-600 font-medium transition-colors hover:text-slate-900 aria-[current=page]:text-slate-900 aria-[current=page]:font-semibold aria-[current=page]:border-accent';
const mobileNavLinkClass =
  'min-h-[44px] flex items-center text-sm pl-3 -ml-3 border-l-4 border-l-transparent border-b border-slate-100 last:border-b-0 text-slate-700 font-medium hover:text-slate-900 aria-[current=page]:text-slate-900 aria-[current=page]:font-semibold aria-[current=page]:border-l-accent aria-[current=page]:bg-surface';
---

<header
  class:list={[
    'transition-[background-color,border-color,box-shadow] duration-200 motion-reduce:transition-none',
    'group-data-[scrolled]:shadow-sm',
    'bg-white/95 backdrop-blur border-b border-slate-200',
  ]}
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 h-16 sm:h-20 group-data-[scrolled]:h-12 sm:group-data-[scrolled]:h-14 flex items-center justify-between gap-4 transition-[height] duration-200 motion-reduce:transition-none">
    <a href={url('')} class="flex items-center gap-2 shrink-0 min-h-[44px]">
      <img src={url('images/logo.png')} alt="Abhijit Sinha logo" class="h-9 sm:h-11 group-data-[scrolled]:h-7 sm:group-data-[scrolled]:h-8 w-auto transition-[height] duration-200 motion-reduce:transition-none" />
      <span class="hidden sm:flex flex-col leading-tight">
        <span class="font-bold text-slate-900 text-base">Abhijit Sinha</span>
        <span class="text-xs text-slate-500">Mutual Fund Distributor</span>
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-6" aria-label="Primary">
      {nav.map((item) => (
        <a
          href={url(item.href.replace(/^\//, ''))}
          data-nav-href={item.href}
          aria-current={isActiveNavItem(item.href) ? 'page' : undefined}
          class={desktopNavLinkClass}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={url(primaryCta.href.replace(/^\//, ''))}
        class="hidden sm:inline-flex items-center justify-center min-h-[44px] px-4 py-2 rounded-lg bg-slate-900 text-white text-sm font-semibold hover:bg-slate-800 transition-colors"
      >
        {primaryCta.label}
      </a>

      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden inline-flex items-center justify-center h-11 w-11 rounded-lg border border-slate-200 text-slate-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <svg id="icon-open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="lg:hidden hidden border-t border-slate-200 bg-white">
    <nav class="px-4 py-3 flex flex-col" aria-label="Mobile Primary">
      {nav.map((item) => (
        <a
          href={url(item.href.replace(/^\//, ''))}
          data-nav-href={item.href}
          aria-current={isActiveNavItem(item.href) ? 'page' : undefined}
          class={mobileNavLinkClass}
        >
          {item.label}
        </a>
      ))}
      <a
        href={url(primaryCta.href.replace(/^\//, ''))}
        class="mt-3 min-h-[44px] flex items-center justify-center rounded-lg bg-slate-900 text-white text-sm font-semibold px-4"
      >
        {primaryCta.label}
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  function closeMenu() {
    if (!btn || !menu || !iconOpen || !iconClose) return;
    menu.classList.add('hidden');
    iconOpen.classList.remove('hidden');
    iconClose.classList.add('hidden');
    btn.setAttribute('aria-expanded', 'false');
    btn.setAttribute('aria-label', 'Open menu');
  }

  function openMenu() {
    if (!btn || !menu || !iconOpen || !iconClose) return;
    menu.classList.remove('hidden');
    iconOpen.classList.add('hidden');
    iconClose.classList.remove('hidden');
    btn.setAttribute('aria-expanded', 'true');
    btn.setAttribute('aria-label', 'Close menu');
  }

  btn?.addEventListener('click', () => {
    const isOpen = btn.getAttribute('aria-expanded') === 'true';
    isOpen ? closeMenu() : openMenu();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });

  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));
</script>
