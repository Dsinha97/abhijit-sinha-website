---
// Provider-agnostic booking widget. Switches on site.scheduler.provider so
// swapping between Cal.com, Calendly, or Google Calendar Appointment
// Schedules later is a one-line edit to src/data/site.ts, never a template
// change. See docs/wiki/page-schedule.md.
//
// The booking widget is click-to-load, the same treatment the Knowledge Corner
// gives YouTube: no request reaches the scheduler until the visitor asks for
// the calendar. That keeps a third-party embed off every /schedule page view,
// which is what Privacy Policy 5.4 promises. Do not add a preconnect, a
// prefetch or a provider script tag here - any of them would fire on load and
// break that promise.
import { scheduler, distributor } from '../data/site';

const { provider, url: schedulerUrl } = scheduler;
---

{provider !== 'none' && schedulerUrl ? (
  <div
    data-scheduler-slot
    class="rounded-xl border border-slate-200 overflow-hidden bg-white h-full min-h-[560px]"
  >
    <div class="flex h-full min-h-[560px] flex-col justify-center gap-5 p-6 text-center sm:p-8">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-accent">Book a Time</p>
        <h3 class="mt-1 text-lg font-bold text-slate-900">Pick a slot that works for you</h3>
        <p class="mx-auto mt-3 max-w-md text-sm text-slate-600">
          The calendar is provided by Calendly. Nothing is requested from Calendly until you
          open it, so loading this page contacts no one but this website.
        </p>
      </div>

      <div class="flex flex-col items-center gap-3">
        <button
          type="button"
          data-scheduler-load
          data-url={schedulerUrl}
          data-track="cta"
          data-track-label="Load booking calendar"
          class="inline-flex min-h-[44px] items-center justify-center rounded-lg bg-slate-900 px-6 py-3 text-sm font-medium text-white transition hover:bg-slate-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        >
          Load booking calendar
        </button>
        <a
          href={schedulerUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-track="cta"
          data-track-label="Open booking calendar in new tab"
          class="inline-flex min-h-[44px] items-center text-sm font-medium text-accent hover:underline"
        >
          Or open the calendar in a new tab
          <span class="sr-only">(opens in a new tab)</span>
        </a>
      </div>

      <p class="text-xs text-slate-500">
        Prefer to talk first? Email{' '}
        <a href={`mailto:${distributor.email}`} class="text-accent underline underline-offset-2">
          {distributor.email}
        </a>{' '}
        or call{' '}
        <a href={distributor.phoneHref} class="text-accent underline underline-offset-2">
          {distributor.phone}
        </a>.
      </p>
    </div>
  </div>
) : (
  <div class="rounded-xl border border-slate-200 bg-surface p-6 sm:p-8 h-full flex flex-col justify-center gap-5">
    <div>
      <p class="text-xs font-semibold tracking-wide text-accent uppercase mb-1">Prefer a Written Inquiry or Direct Call?</p>
      <p class="text-sm text-slate-600">
        Online booking is being set up. If you cannot find a suitable time slot yet or prefer direct communication, reach out through the channels below:
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
      <div class="rounded-lg border border-slate-200 bg-white p-4">
        <p class="text-xs font-semibold text-slate-500 uppercase mb-1">Direct Email</p>
        <a href={`mailto:${distributor.email}`} class="text-accent font-medium break-all">{distributor.email}</a>
      </div>
      <div class="rounded-lg border border-slate-200 bg-white p-4">
        <p class="text-xs font-semibold text-slate-500 uppercase mb-1">Direct Phone</p>
        <a href={distributor.phoneHref} class="text-accent font-medium">{distributor.phone}</a>
        <p class="text-xs text-slate-500 mt-1">Available Monday to Friday, 10:00 AM – 6:00 PM IST</p>
      </div>
    </div>
  </div>
)}

<script>
  // Swap the facade for the real embed, and only then. Delegated for the same
  // reason as the video facade: one listener, no per-render wiring.
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const btn = target.closest('[data-scheduler-load]');
    if (!(btn instanceof HTMLElement)) return;

    const src = btn.getAttribute('data-url');
    const slot = btn.closest('[data-scheduler-slot]');
    if (!src || !slot) return;

    const iframe = document.createElement('iframe');
    iframe.src = src;
    iframe.title = 'Book a meeting with Abhijit Sinha';
    iframe.className = 'w-full h-full min-h-[560px] border-0';
    iframe.loading = 'lazy';
    // allow-popups-to-escape-sandbox matters: Calendly's confirmation step
    // opens out of the frame, and without it that window inherits the sandbox
    // and dies.
    iframe.setAttribute(
      'sandbox',
      'allow-scripts allow-same-origin allow-forms allow-popups allow-popups-to-escape-sandbox',
    );

    slot.replaceChildren(iframe);
  });
</script>
