# ---------------------------------------------------------------------------
# TEMPLATE ONLY — copy to .env and fill in.
# ---------------------------------------------------------------------------
# This file is committed to a PUBLIC repository. It must never become a copy of
# a working .env: keep every value here a placeholder, even for values that are
# public by design, so that "add it to .env.example too" can never leak a real
# credential by habit. Real values live in the Vercel project settings
# (Settings -> Environment Variables) and, for secrets, in the Supabase
# dashboard under Edge Functions -> Secrets.

# ---------------------------------------------------------------------------
# Contact forms
# ---------------------------------------------------------------------------
# POST endpoint for the homepage inquiry form and the Investor Services request
# form. Points at the Supabase `verify-lead` edge function, which checks the
# Turnstile token, honeypot, dwell time and per-IP rate limit, then forwards to
# `submit-lead` — which validates the submission, stores it in the `leads`
# table, and emails a copy. Repointing this at `.../submit-lead` is the
# one-line rollback if the gate ever misbehaves.
# Leave empty to ship the forms in a disabled/informational state.
PUBLIC_FORM_ENDPOINT=https://<project-ref>.supabase.co/functions/v1/verify-lead

# Cloudflare Turnstile SITE key (the public half; the secret half is a Supabase
# edge-function secret — see the bottom of this file). Leave empty for local
# development: no widget renders, nothing is requested from Cloudflare, and
# `verify-lead` forwards unverified because its secret is unset.
PUBLIC_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Used by the /admin dashboard and the build-time content fetch. Both values are
# PUBLIC by design: the publishable key only grants what Row Level Security
# allows, and every admin-only table is gated on the caller's email being in
# the `admin_allowlist` table.
#
# NEVER put the service_role key in this file or anywhere under src/ or public/.
# It bypasses RLS entirely and belongs only in Supabase edge-function secrets.
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_<publishable-key>

# POST endpoint for the first-party analytics beacon (the `track` edge
# function). Leave empty to disable tracking entirely: the client script then
# makes no network request at all. Cookieless and stores no IP or user-agent —
# disclosed in privacy-policy.astro section 5.2.
PUBLIC_ANALYTICS_ENDPOINT=https://<project-ref>.supabase.co/functions/v1/track

# ---------------------------------------------------------------------------
# Secrets that do NOT belong here
# ---------------------------------------------------------------------------
# Set these in the Supabase dashboard (Edge Functions -> Secrets), not in .env:
#   WEB3FORMS_ACCESS_KEY    - access key for the lead notification email
#   TURNSTILE_SECRET_KEY    - Turnstile secret half, read by `verify-lead`.
#                             While unset, `verify-lead` forwards unverified
#                             rather than rejecting: a mis-set secret must never
#                             take the only lead channel offline.
#   SUBMIT_LEAD_URL         - optional override for where `verify-lead` forwards
#                             to; defaults to ${SUPABASE_URL}/functions/v1/submit-lead
#   ALLOWED_ORIGINS         - optional CORS override, comma-separated
#   VERCEL_DEPLOY_HOOK_URL  - deploy hook POSTed by `publish-site`
