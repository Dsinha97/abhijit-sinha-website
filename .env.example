# ---------------------------------------------------------------------------
# Contact forms
# ---------------------------------------------------------------------------
# POST endpoint for the homepage inquiry form and the Investor Services request
# form. Points at the Supabase `submit-lead` edge function, which validates the
# submission, stores it in the `leads` table, and emails a copy.
# Leave empty to ship the forms in a disabled/informational state.
PUBLIC_FORM_ENDPOINT=https://cebfypcoyqiegwuahmun.supabase.co/functions/v1/submit-lead

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Used by the /admin dashboard (Phase 2) and the build-time content fetch
# (Phase 3). Both values are PUBLIC by design: the publishable key only grants
# what Row Level Security allows, and every admin-only table is gated on the
# caller's email being in the `admin_allowlist` table.
#
# NEVER put the service_role key in this file or anywhere under src/ or public/.
# It bypasses RLS entirely and belongs only in Supabase edge-function secrets.
PUBLIC_SUPABASE_URL=https://cebfypcoyqiegwuahmun.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YszlNtOp_qV7j_2Xz1y5ww_Q5H5G_Hg

# ---------------------------------------------------------------------------
# Secrets that do NOT belong here
# ---------------------------------------------------------------------------
# Set these in the Supabase dashboard (Edge Functions -> Secrets), not in .env:
#   WEB3FORMS_ACCESS_KEY  - access key for the lead notification email
#   ALLOWED_ORIGINS       - optional CORS override, comma-separated
#   GITHUB_DISPATCH_TOKEN - Phase 3 rebuild trigger (fine-grained PAT)
